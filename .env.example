# Run python deploy/setup_env.py to generate .env with random local secrets.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DEMO_PASSWORD=
API_PORT=8020
# Phase 2: python deploy/setup_odoo_env.py appends these random values.
ODOO_DB_PASSWORD=
ODOO_ADMIN_PASSWORD=
OPS_SIGNING_KEY=
# Phase 3 optional hosted inference; configure locally, never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Phase 5: explicit scoped domain identity; no role escalation for seeded worker role.
WORKER_USERNAME=
WORKER_PASSWORD=
WORKER_TENANT_ID=
WORKER_TRANSPORT=mcp
